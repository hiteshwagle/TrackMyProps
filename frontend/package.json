{
  "name": "trackmyprops-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "expo": "57.0.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.5",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
