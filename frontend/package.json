{
  "name": "trackmyprops-frontend",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13 <23",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "npm run dev",
    "predev": "npm run validate:dev",
    "dev": "node --env-file=.env.development scripts/run-expo.mjs start --web",
    "preandroid": "npm run validate:dev",
    "android": "node --env-file=.env.development scripts/run-expo.mjs start --android",
    "preios": "npm run validate:dev",
    "ios": "node --env-file=.env.development scripts/run-expo.mjs start --ios",
    "web": "npm run dev",
    "preprod": "npm run build:prod",
    "prod": "node --env-file=.env.production scripts/run-expo.mjs serve --port 4173",
    "build": "node scripts/run-expo.mjs export --platform web --output-dir dist",
    "prebuild:dev": "npm run validate:dev",
    "build:dev": "node --env-file=.env.development scripts/run-expo.mjs export --dev --platform web --output-dir dist-development",
    "prebuild:prod": "npm run validate:prod",
    "build:prod": "node --env-file=.env.production scripts/run-expo.mjs export --platform web --output-dir dist",
    "validate:dev": "node --env-file=.env.development scripts/validate-environment.mjs development",
    "validate:prod": "node --env-file=.env.production scripts/validate-environment.mjs production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci --runInBand"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@hookform/resolvers": "5.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.112.2",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.9",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.85.0",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.5",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.1",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "nanoid": "3.3.17"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ]
  }
}
