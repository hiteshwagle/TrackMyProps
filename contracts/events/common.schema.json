{
  "$id": "urn:trackmyprops:contracts:events:envelope:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable, transport-neutral envelope for a fact that has already occurred.",
  "properties": {
    "actor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        }
      },
      "required": ["type", "id"],
      "type": "object"
    },
    "aggregate": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "type": "string"
        },
        "type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "version": {
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        }
      },
      "required": ["type", "id", "version"],
      "type": "object"
    },
    "causation_id": {
      "format": "uuid",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "type": "string"
    },
    "environment": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "event_version": {
      "pattern": "^[1-9][0-9]*\\.[0-9]+$",
      "type": "string"
    },
    "household_id": {
      "format": "uuid",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "producer": {
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "type": "string"
    },
    "tenant_id": {
      "format": "uuid",
      "type": "string"
    },
    "trace_id": {
      "format": "uuid",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "environment",
    "trace_id",
    "aggregate",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
