{
  "$id": "urn:trackmyprops:contracts:common:money:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A monetary amount represented without binary floating point.",
  "properties": {
    "amount": {
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$",
      "type": "string"
    },
    "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    }
  },
  "required": ["amount", "currency"],
  "title": "Money",
  "type": "object"
}
